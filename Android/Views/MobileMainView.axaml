<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NetRadio.ViewModels"
             xmlns:models="using:NetRadio.Models"
             xmlns:conv="using:NetRadio.Converters"
             x:Class="NetRadio.Droid.Views.MobileMainView"
             x:DataType="vm:MainViewModel">

    <UserControl.Resources>
        <conv:StationInitialConverter x:Key="StationInitial" />
        <conv:StationAvatarBrushConverter x:Key="StationAvatar" />
        <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
        <conv:FavoriteIconConverter x:Key="FavoriteIcon" />
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- 分类胶囊 -->
        <Style Selector="ListBox#CategoryList > ListBoxItem">
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="ListBox#CategoryList > ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ListBox#CategoryList > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>

        <!-- 电台行 -->
        <Style Selector="ListBox#StationList > ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox#StationList > ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>
        <Style Selector="ListBox#StationList > ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>

        <Style Selector="Button.stationRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="16,9" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.stationRow:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource CardHoverBrush}" />
        </Style>
        <Style Selector="Button.stationRow:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
        </Style>

        <!-- 底栏圆形播放键 -->
        <Style Selector="Button.playButton">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.playButton /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
            <Setter Property="CornerRadius" Value="999" />
        </Style>

        <!-- 弹出菜单项 -->
        <Style Selector="Button.flyoutItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>

        <!-- 播放中的跳动电平条 -->
        <Style Selector="Border.eqBar">
            <Setter Property="Width" Value="2.5" />
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="1.25" />
            <Setter Property="Background" Value="{DynamicResource OnAirBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Height" Value="4" />
                    </KeyFrame>
                    <KeyFrame Cue="45%">
                        <Setter Property="Height" Value="13" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Height" Value="4" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.eqBar.b2">
            <Style.Animations>
                <Animation Duration="0:0:1.15" Delay="0:0:0.12" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Height" Value="11" />
                    </KeyFrame>
                    <KeyFrame Cue="50%">
                        <Setter Property="Height" Value="4" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Height" Value="11" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Border.eqBar.b3">
            <Style.Animations>
                <Animation Duration="0:0:0.78" Delay="0:0:0.26" IterationCount="INFINITE" Easing="SineEaseInOut">
                    <KeyFrame Cue="0%">
                        <Setter Property="Height" Value="5" />
                    </KeyFrame>
                    <KeyFrame Cue="40%">
                        <Setter Property="Height" Value="14" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Height" Value="5" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </UserControl.Styles>

    <Grid x:Name="RootGrid" RowDefinitions="Auto,*,Auto" Background="{DynamicResource AppBackgroundBrush}">

        <!-- ===== 顶部：品牌 + 搜索 + 分类 ===== -->
        <Border x:Name="HeaderBar" Grid.Row="0" Padding="16,12,16,10"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,0,0,1">
            <StackPanel Spacing="11">

                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <Border Width="34" Height="34" CornerRadius="11"
                            Background="{DynamicResource AccentGradientBrush}">
                        <PathIcon Data="{StaticResource IconBroadcast}" Width="18" Height="18" Foreground="White" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="NetRadio" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="网络收音机" FontSize="10.5"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <Button Grid.Column="2" Classes="icon" Width="36" Height="36" Padding="0"
                            ToolTip.Tip="睡眠定时">
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedRight">
                                <StackPanel Spacing="2" Width="150">
                                    <TextBlock Text="{Binding SleepTimerText, StringFormat='剩余 {0}'}"
                                               FontSize="12" Margin="10,6,10,4"
                                               IsVisible="{Binding IsSleepTimerActive}"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <Button Classes="flyoutItem" Content="15 分钟"
                                            Command="{Binding SetSleepTimerCommand}" CommandParameter="15" />
                                    <Button Classes="flyoutItem" Content="30 分钟"
                                            Command="{Binding SetSleepTimerCommand}" CommandParameter="30" />
                                    <Button Classes="flyoutItem" Content="60 分钟"
                                            Command="{Binding SetSleepTimerCommand}" CommandParameter="60" />
                                    <Button Classes="flyoutItem" Content="关闭定时"
                                            Command="{Binding SetSleepTimerCommand}" CommandParameter="0" />
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <Panel>
                            <PathIcon Data="{StaticResource IconTimer}" Width="17" Height="17"
                                      Foreground="{DynamicResource AccentBrush}"
                                      IsVisible="{Binding IsSleepTimerActive}" />
                            <PathIcon Data="{StaticResource IconTimer}" Width="17" Height="17"
                                      Foreground="{DynamicResource TextSecondaryBrush}"
                                      IsVisible="{Binding !IsSleepTimerActive}" />
                        </Panel>
                    </Button>

                    <Button Grid.Column="3" Classes="icon" Width="36" Height="36" Padding="0"
                            Command="{Binding RefreshCommand}" ToolTip.Tip="刷新列表">
                        <PathIcon Data="{StaticResource IconRefresh}" Width="17" Height="17"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </Grid>

                <!-- 搜索 -->
                <Border Height="42" CornerRadius="12" Padding="12,0"
                        Background="{DynamicResource SubtleSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*">
                        <PathIcon Data="{StaticResource IconSearch}" Width="16" Height="16"
                                  VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBox Grid.Column="1" Classes="inline" Margin="8,0,0,0"
                                 Text="{Binding SearchText, Mode=TwoWay}"
                                 PlaceholderText="搜索电台，例如 华语、jazz、BBC" />
                    </Grid>
                </Border>

                <!-- 分类 -->
                <ListBox x:Name="CategoryList" ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:CategoryItem">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <PathIcon Data="{Binding Icon}" Width="13" Height="13" VerticalAlignment="Center"
                                          Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                                <TextBlock Text="{Binding Name}" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{Binding $parent[ListBoxItem].Foreground}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

        <!-- ===== 电台列表 ===== -->
        <Grid Grid.Row="1">
            <ListBox x:Name="StationList" ItemsSource="{Binding Stations}"
                     SelectedItem="{Binding SelectedStation, Mode=TwoWay}"
                     Background="Transparent" BorderThickness="0" Padding="0,4,0,4"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:RadioStation">
                        <Button Classes="stationRow"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).PlayCommand}"
                                CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                <!-- 台标 -->
                                <Border Width="44" Height="44" CornerRadius="13" Classes="avatar"
                                        Background="{Binding Name, Converter={StaticResource StationAvatar}}">
                                    <Grid>
                                        <Border Classes="gloss" CornerRadius="13" />
                                        <TextBlock Text="{Binding Name, Converter={StaticResource StationInitial}}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   FontSize="17" FontWeight="Bold" Foreground="#F2FFFFFF" />
                                    </Grid>
                                </Border>

                                <!-- 名称 / 副标题 / 当前曲目 -->
                                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding DisplaySubtitle}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                    <TextBlock Text="{Binding NowPlaying}" FontSize="11"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding NowPlaying, Converter={StaticResource NotEmpty}}"
                                               Foreground="{DynamicResource AccentBrush}" />
                                </StackPanel>

                                <!-- 播放中指示 -->
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2.5"
                                            VerticalAlignment="Center" Margin="0,0,4,0"
                                            IsVisible="{Binding IsPlaying}">
                                    <Border Classes="eqBar" />
                                    <Border Classes="eqBar b2" />
                                    <Border Classes="eqBar b3" />
                                </StackPanel>

                                <!-- 收藏 -->
                                <Button Grid.Column="3" Classes="icon" Width="38" Height="38" Padding="0"
                                        Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).ToggleFavoriteCommand}"
                                        CommandParameter="{Binding}">
                                    <PathIcon Width="17" Height="17" Foreground="#F5A524"
                                              Data="{Binding IsFavorite, Converter={StaticResource FavoriteIcon}}" />
                                </Button>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- 空状态 -->
            <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Spacing="8" Margin="32">
                <PathIcon Data="{StaticResource IconBroadcast}" Width="38" Height="38"
                          Foreground="{DynamicResource TextTertiaryBrush}" Opacity="0.7" />
                <TextBlock Text="{Binding StatusMessage}" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <!-- 加载进度 -->
            <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="2"
                         VerticalAlignment="Top" Margin="0,0,0,0" />
        </Grid>

        <!-- ===== 底部播放条 ===== -->
        <Border x:Name="PlayerBar" Grid.Row="2" Padding="12,9,12,12"
                Background="{DynamicResource PlayerBarBrush}"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                IsVisible="{Binding HasCurrentStation}">
            <Grid ColumnDefinitions="Auto,*,Auto">

                <Border Width="42" Height="42" CornerRadius="13" Classes="avatar" VerticalAlignment="Center"
                        Background="{Binding CurrentStation.Name, Converter={StaticResource StationAvatar}}">
                    <Grid>
                        <Border Classes="gloss" CornerRadius="13" />
                        <TextBlock Text="{Binding CurrentStation.Name, Converter={StaticResource StationInitial}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="16" FontWeight="Bold" Foreground="#F2FFFFFF" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="11,0,8,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding CurrentStation.Name}" FontSize="13.5" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Classes="onAir" Width="5" Height="5" IsVisible="{Binding IsPlaying}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding NowPlaying}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding NowPlaying, Converter={StaticResource NotEmpty}}"
                               Foreground="{DynamicResource AccentBrush}" Opacity="0.85" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <Button Classes="icon" Width="34" Height="34" Padding="0"
                            Command="{Binding PlayPreviousCommand}" ToolTip.Tip="上一曲">
                        <PathIcon Data="{StaticResource IconPrevious}" Width="16" Height="16"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>

                    <Border Width="44" Height="44" CornerRadius="22" BoxShadow="0 4 12 0 #40F2552E">
                        <Button Classes="playButton" Width="44" Height="44"
                                Command="{Binding TogglePlayPauseCommand}">
                            <PathIcon Width="19" Height="19" Foreground="White"
                                      Data="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" />
                        </Button>
                    </Border>

                    <Button Classes="icon" Width="34" Height="34" Padding="0"
                            Command="{Binding PlayNextCommand}" ToolTip.Tip="下一曲">
                        <PathIcon Data="{StaticResource IconNext}" Width="16" Height="16"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
