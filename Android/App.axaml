<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NetRadio.Droid.App"
             RequestedThemeVariant="Default">

    <!-- 与桌面端共用同一份设计令牌与控件样式 -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://NetRadio/Assets/Theme.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://NetRadio/Assets/Styles.axaml" />
    </Application.Styles>
</Application>
