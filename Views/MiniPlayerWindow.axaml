<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetRadio.ViewModels"
        xmlns:conv="using:NetRadio.Converters"
        x:Class="NetRadio.Views.MiniPlayerWindow"
        x:DataType="vm:MainViewModel"
        Width="316" Height="156"
        CanResize="False"
        ShowInTaskbar="True"
        WindowDecorations="None"
        WindowStartupLocation="Manual"
        Background="{DynamicResource PlayerBarBrush}"
        Title="NetRadio 小窗口">

    <Window.Resources>
        <conv:StationInitialConverter x:Key="StationInitial" />
        <conv:StationAvatarBrushConverter x:Key="StationAvatar" />
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
        <conv:PlayPauseIconConverter x:Key="PlayPauseIcon" />
        <conv:VolumeIconConverter x:Key="VolumeIcon" />
    </Window.Resources>

    <Border BorderBrush="{DynamicResource BorderBrushStrong}" BorderThickness="1"
            Background="{DynamicResource PlayerBarBrush}">
        <Grid RowDefinitions="26,*,Auto" Margin="10,0,10,8">

            <!-- ===== 自绘标题栏（可拖拽） ===== -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto,Auto"
                  Background="Transparent"
                  PointerPressed="OnTitleBarPointerPressed">
                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                    <Border Width="14" Height="14" CornerRadius="4"
                            Background="{DynamicResource AccentGradientBrush}">
                        <PathIcon Data="{StaticResource IconBroadcast}" Width="9" Height="9" Foreground="White" />
                    </Border>
                    <TextBlock Text="NetRadio" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>

                <Button x:Name="PinButton" Grid.Column="1" Classes="icon" Width="22" Height="22" Padding="0"
                        Click="OnPinClick" ToolTip.Tip="切换置顶">
                    <PathIcon Data="{StaticResource IconPin}" Width="10" Height="10"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
                <Button Grid.Column="2" Classes="icon" Width="22" Height="22" Padding="0"
                        Command="{Binding ShowMainWindowCommand}" ToolTip.Tip="返回主界面">
                    <PathIcon Data="{StaticResource IconExpand}" Width="10" Height="10"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
                <Button Grid.Column="3" Classes="icon" Width="22" Height="22" Padding="0"
                        Click="OnCloseClick" ToolTip.Tip="关闭小窗口">
                    <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"
                              Foreground="{DynamicResource TextTertiaryBrush}" />
                </Button>
            </Grid>

            <!-- ===== 台标 / 信息 / 控制 ===== -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">

                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="13" Classes="avatar"
                        Background="{Binding CurrentStation.Name, Converter={StaticResource StationAvatar}}"
                        BoxShadow="0 3 9 0 #26000000">
                    <Grid>
                        <Border Classes="gloss" CornerRadius="13" />
                        <TextBlock Text="{Binding CurrentStation.Name, Converter={StaticResource StationInitial}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="18" FontWeight="Bold" Foreground="#F2FFFFFF" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center" Spacing="2">
                    <TextBlock Text="{Binding CurrentStation.Name}" FontSize="13" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <Ellipse Classes="onAir" Width="5" Height="5" IsVisible="{Binding IsPlaying}" />
                        <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <TextBlock Text="{Binding NowPlaying}" FontSize="10.5"
                               TextTrimming="CharacterEllipsis"
                               IsVisible="{Binding NowPlaying, Converter={StaticResource NotEmpty}}"
                               Foreground="{DynamicResource AccentBrush}" Opacity="0.85" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button Classes="icon" Width="27" Height="27" Padding="0"
                            Command="{Binding PlayPreviousCommand}"
                            ToolTip.Tip="上一曲" IsEnabled="{Binding CanSwitchStation}">
                        <PathIcon Data="{StaticResource IconPrevious}" Width="13" Height="13"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>

                    <Border Width="36" Height="36" CornerRadius="18" BoxShadow="0 4 10 0 #40F2552E">
                        <Button Classes="round" Width="36" Height="36"
                                Command="{Binding TogglePlayPauseCommand}" ToolTip.Tip="播放 / 暂停">
                            <PathIcon Width="16" Height="16" Foreground="White"
                                      Data="{Binding IsPlaying, Converter={StaticResource PlayPauseIcon}}" />
                        </Button>
                    </Border>

                    <Button Classes="icon" Width="27" Height="27" Padding="0"
                            Command="{Binding PlayNextCommand}"
                            ToolTip.Tip="下一曲" IsEnabled="{Binding CanSwitchStation}">
                        <PathIcon Data="{StaticResource IconNext}" Width="13" Height="13"
                                  Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== 音量 ===== -->
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,7,0,0">
                <Button Grid.Column="0" Classes="icon" Width="23" Height="23" Padding="0"
                        Command="{Binding ToggleMuteCommand}" ToolTip.Tip="静音">
                    <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextSecondaryBrush}"
                              Data="{Binding IsMuted, Converter={StaticResource VolumeIcon}}" />
                </Button>
                <Slider Grid.Column="1" Margin="5,0,7,0" Minimum="0" Maximum="100"
                        Value="{Binding Volume, Mode=TwoWay}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Width="20" FontSize="10.5" VerticalAlignment="Center"
                           Text="{Binding Volume}"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </Grid>
        </Grid>
    </Border>
</Window>
