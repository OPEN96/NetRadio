<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetRadio.ViewModels"
        xmlns:conv="using:NetRadio.Converters"
        x:Class="NetRadio.Views.StationEditorWindow"
        x:DataType="vm:StationEditorViewModel"
        Width="520" Height="480"
        MinWidth="480" MinHeight="440"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="{Binding Title}">

    <Window.Resources>
        <conv:StringNotEmptyConverter x:Key="NotEmpty" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="TextBlock.fieldLabel">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="26,22,26,18">

        <StackPanel Grid.Row="0" Spacing="3">
            <TextBlock Text="{Binding Title}" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="支持 http / https 直播流，以及 .m3u8 播放列表地址"
                       FontSize="11.5" Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,16,0,0" HorizontalScrollBarVisibility="Disabled">
            <Border Classes="card" Padding="16" VerticalAlignment="Top">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="电台名称 *" />
                        <TextBox Text="{Binding Name, Mode=TwoWay}" PlaceholderText="例如：城市之声" />
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Classes="fieldLabel" Text="流媒体地址 *" />
                        <TextBox Text="{Binding Url, Mode=TwoWay}"
                                 PlaceholderText="https://example.com/stream.mp3" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,7,0">
                            <TextBlock Classes="fieldLabel" Text="国家 / 地区" />
                            <TextBox Text="{Binding Country, Mode=TwoWay}" PlaceholderText="中国" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="7,0,0,0">
                            <TextBlock Classes="fieldLabel" Text="语言" />
                            <TextBox Text="{Binding Language, Mode=TwoWay}" PlaceholderText="chinese" />
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="*,*">
                        <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,7,0">
                            <TextBlock Classes="fieldLabel" Text="标签（英文逗号分隔）" />
                            <TextBox Text="{Binding Tags, Mode=TwoWay}" PlaceholderText="music,news" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="6" Margin="7,0,0,0">
                            <TextBlock Classes="fieldLabel" Text="官网" />
                            <TextBox Text="{Binding Homepage, Mode=TwoWay}" PlaceholderText="https://" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="#E4572E" FontSize="12"
                               TextWrapping="Wrap"
                               IsVisible="{Binding ErrorMessage, Converter={StaticResource NotEmpty}}" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                    Spacing="10" Margin="0,16,0,0">
            <Button Content="取消" Width="92" Height="36" Classes="outline" Click="OnCancelClick" />
            <Button Content="保存" Width="92" Height="36" Classes="accent" Click="OnSaveClick" />
        </StackPanel>
    </Grid>
</Window>
