<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NetRadio.ViewModels"
        x:Class="NetRadio.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Width="560" Height="700"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        Background="{DynamicResource AppBackgroundBrush}"
        Title="设置">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- 标题 -->
        <StackPanel Grid.Row="0" Margin="26,22,26,0" Spacing="3">
            <TextBlock Text="设置" FontSize="19" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="外观、播放与窗口行为" FontSize="11.5"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <!-- 分组卡片 -->
        <ScrollViewer Grid.Row="1" Margin="26,16,26,0"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="12">

                <!-- 外观 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="label" Text="外观" />

                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0" Text="主题" FontSize="12.5" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <ComboBox Grid.Column="1" Width="180" HorizontalAlignment="Right"
                                      ItemsSource="{Binding Themes}"
                                      SelectedItem="{Binding Theme, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 播放 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="12">
                        <TextBlock Classes="label" Text="播放" />

                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="网络缓冲" FontSize="12.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Border Grid.Column="1" Classes="chip">
                                    <TextBlock Text="{Binding NetworkCachingMs}" FontSize="11"
                                               Foreground="{DynamicResource ChipTextBrush}" />
                                </Border>
                            </Grid>
                            <Slider Minimum="300" Maximum="20000" TickFrequency="100"
                                    Value="{Binding NetworkCachingMs, Mode=TwoWay}" />
                            <TextBlock Text="网络较差时可调高，减少卡顿；但会增加开始播放的等待时间。"
                                       FontSize="11" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>

                        <Border Height="1" Background="{DynamicResource BorderBrushSoft}" Margin="0,2" />

                        <CheckBox Content="启动时自动播放上次收听的电台"
                                  IsChecked="{Binding AutoPlayLastStation, Mode=TwoWay}" />
                    </StackPanel>
                </Border>

                <!-- 托盘与窗口 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label" Text="托盘与窗口" />

                        <CheckBox Content="最小化主窗口时隐藏到系统托盘"
                                  IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                        <CheckBox Content="点击关闭按钮时最小化到托盘（不退出程序）"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                        <CheckBox Content="小窗口播放时始终置顶"
                                  IsChecked="{Binding MiniPlayerAlwaysOnTop, Mode=TwoWay}" />
                        <TextBlock Text="关闭「关闭到托盘」后，从托盘菜单选择「退出」即可结束程序。"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- 存储 -->
                <Border Classes="card" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="label" Text="存储" />

                        <TextBlock Text="录音保存目录" FontSize="12.5"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBox Text="{Binding RecordingsFolder, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- 底部操作 -->
        <Border Grid.Row="2" Padding="26,14,26,18"
                BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0"
                Background="{DynamicResource PanelBackgroundBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="取消" Width="92" Height="36" Classes="outline" Click="OnCancelClick" />
                <Button Content="保存" Width="92" Height="36" Classes="accent" Click="OnSaveClick" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
